{
  "name": "paga-justo-backend",
  "version": "1.0.0",
  "description": "Backend para PagaJusto - NestJS con Prisma y Stellar SDK",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/from-src/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:ts": "ts-node -r tsconfig-paths/register src/main.ts",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "test": "node --test test/*.test.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "11.2.5",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.5",
    "@prisma/client": "6.19.3",
    "@stellar/stellar-sdk": "17.1.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "lodash": "4.18.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.1.14",
    "rimraf": "6.1.3",
    "uuid": "14.0.2",
    "zod": "3.25.76",
    "@pagajusto/shared": "file:../../packages/shared"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/lodash": "4.17.25",
    "@types/node": "20.19.43",
    "@types/passport-jwt": "4.0.1",
    "prisma": "6.19.3",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}
