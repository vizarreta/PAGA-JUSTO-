# PostgreSQL local de docker-compose.yml
DATABASE_URL="postgresql://paga_justo:paga_justo_dev@127.0.0.1:5432/paga_justo?schema=public"
DIRECT_URL="postgresql://paga_justo:paga_justo_dev@127.0.0.1:5432/paga_justo?schema=public"

# Obligatorio: genera un valor aleatorio, nunca uses este ejemplo como secreto.
JWT_SECRET=
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Una instancia por acuerdo; no hay contrato global compartido.
# La integración de transacciones desde la API está pendiente.

# Reservadas para la siguiente etapa; el proveedor aún no está integrado.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
