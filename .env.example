# Para desarrollo local, usar apps/api/.env.example (PostgreSQL de Docker Compose).
# Este ejemplo conserva la configuración previa de Supabase.
# IA y pagos desde la web siguen pendientes; consultar docs/implementation-status.md.
# ═══════════════════════════════════════════════════
# BASE DE DATOS — Supabase (PostgreSQL)
# ═══════════════════════════════════════════════════
# Ve a: supabase.com → tu proyecto → Settings → Database → Connection string
#
# DATABASE_URL: usa el "Transaction pooler" (puerto 6543) — para el app en producción
# DIRECT_URL:   usa "Session pooler" o "Direct connection" (puerto 5432) — para migraciones Prisma
#
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ═══════════════════════════════════════════════════
# JWT
# ═══════════════════════════════════════════════════
JWT_SECRET=tu-super-secret-jwt-key-cambia-en-produccion-min-32-chars
JWT_EXPIRES_IN=7d

# ═══════════════════════════════════════════════════
# STELLAR / SOROBAN — SOLO TESTNET
# ═══════════════════════════════════════════════════
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Dirección del contrato escrow desplegado en Testnet (se rellena después del deploy)
ESCROW_CONTRACT_ID=

# ═══════════════════════════════════════════════════
# IA — proveedor configurable
# ═══════════════════════════════════════════════════
# Opciones: "google" | "openai" | "anthropic"
AI_PROVIDER=google
# Clave del proveedor elegido (NUNCA commitear el valor real)
AI_API_KEY=
# Modelo a usar (por proveedor)
# Google:    gemini-1.5-flash
# OpenAI:    gpt-4o-mini
# Anthropic: claude-3-haiku-20240307
AI_MODEL=gemini-1.5-flash

# ═══════════════════════════════════════════════════
# SERVIDOR
# ═══════════════════════════════════════════════════
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
